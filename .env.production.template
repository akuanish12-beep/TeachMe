# Production Environment Configuration
# Copy this file to .env and fill in production values

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tutorly.space
FRONTEND_ORIGIN=https://tutorly.space

# Security
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# AI Services
GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_KEY
GEMINI_MODEL=models/gemini-2.5-flash

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRICE_ID_PRO_MONTHLY=price_REPLACE_WITH_PRICE_ID

# Database (Production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tutorly
DB_USER=tutorly_prod
DB_PASS=REPLACE_WITH_SECURE_PASSWORD

# Redis Cache & Rate Limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

